  reviewerId String
  reviewer   User            @relation("PmReviewer", fields: [reviewerId], references: [id])
  verdict    PmReviewVerdict @default(COMMENT)
  rating     Int?
  body       String
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())

  @@index([taskId, createdAt])
  @@index([reviewerId])
  @@index([companyId])
}

model PmComment {
  id        String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
