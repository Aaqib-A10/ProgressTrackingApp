  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId    String
  task      PmTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("PmCommentAuthor", fields: [authorId], references: [id])
  body      String
  mentions  String[]
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([taskId, createdAt])
  @@index([companyId])
}

model PmAttachment {
  id           String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String   @default("")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId       String
