// Metriq — Prisma schema (Phase 1 core).
// Source of truth for the data model: Progress_Tracking_App_Plan.md (§2–§5, §9)
// and CLAUDE.md "Domain rules". Marketing models (SEO/Social/Content/Kanban/
// editorial calendar) are added in Phase 3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  MEMBER // own data only
  TEAM_LEAD // whole department
  SUB_DEPT_LEAD // one Marketing sub-department
  QA // quality-assurance evaluator (scores ITAD/CSR agents)
  QA_LEAD // manages the QA team (all QA powers + QA-team oversight)
  SUPER_ADMIN // everything
}

/// Account approval state. Team Leads self-register as PENDING and must be
/// approved by a Super Admin before they can log in. Everyone else is ACTIVE.
enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

/// Kinds of team-roster changes recorded for the Team History view.
enum TeamEventType {
  INVITED
  REMOVED
  REACTIVATED
}

enum DepartmentType {
  ITAD
  LEAD_GEN
  MARKETING
  CSR
  ECOMMERCE
  TALKLOOP
  INVENTORY
  /// A department a company made itself (Phase 1, step 4): the shared tools (attendance,
  /// projects, chat, daily report…) but none of the department-specific screens.
  GENERAL
}

/// Status of a daily entry. A non-SUBMITTED day carries no metrics and is
/// excluded from averages/targets (leave-aware rule).
enum DayStatus {
  SUBMITTED
  ON_LEAVE
  HOLIDAY
  OFF
}

enum TagType {
  VERTICAL // Lead Gen industry verticals (School District, Telecom, ...)
  LEAD_TYPE // Lead Gen lead categories (New Lead, BBR, RTLG)
  PLATFORM // Social platforms (Facebook, LinkedIn, ...)
  CAMPAIGN
  DATA_SOURCE
  MARKETPLACE // Ecommerce marketplaces (Amazon, eBay, Walmart, Newegg)
  TASK_TYPE // Ecommerce listing task types (BTO, Kits, Pricing, ...)
  COUNTRY // Talkloop target countries (calls/demos per country)
}

enum TargetPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum TargetScope {
  DEPARTMENT
  SUB_DEPARTMENT
  USER
  BRAND // a Marketing brand/profile target (e.g. monthly followers goal)
}

enum LeaveType {
  ON_LEAVE
  HOLIDAY
  OFF
  WFH // Working from home — a worked day: person can still clock in (off-network allowed) and metrics count.
}

/// Tone of a piece of Team Lead → employee feedback.
enum FeedbackSentiment {
  PRAISE
  NEUTRAL
  IMPROVEMENT
}

// ---------- Org structure ----------

model Department {
  id          String         @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId   String         @default("")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        DepartmentType
  name        String
  /// Sections of its kind turned off by the company (lib/sections.ts): hidden, and no new entries.
  sectionsOff String[]       @default([])
  createdAt   DateTime       @default(now())

  subDepartments  SubDepartment[]
  users           User[]
  userMemberships UserDepartment[]
  tags            Tag[]
  targets         Target[]
  feedback        Feedback[]
  qaEvaluations   QaEvaluation[]
  stockRequests   StockRequest[]
  attendanceShift AttendanceShift?
  meetingNotes    MeetingNote[]
  bids            Bid[]
  brands          Brand[]
  businessSuites  BusinessSuite[]
  marketingPlans  MarketingPlan[]
  salaryRecords   SalaryRecord[]
  inventoryItems  InventoryItem[]
  reportForms     ReportForm[]

  @@index([companyId, type])
  @@index([companyId])
}

model SubDepartment {
  id           String     @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String     @default("")
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())

  users           User[]
  userMemberships UserDepartment[]
  targets         Target[]
  marketingPlans  MarketingPlan[]

  @@unique([departmentId, slug])
  @@index([companyId])
}

// ---------- Users & auth ----------

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  /// Optional short sign in name (used by local test accounts); sign in takes email or username.
  username          String?      @unique
  /// The company (or personal workspace) this person belongs to.
  companyId         String       @default("")
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// A role the company made itself (Phase 1, step 4), on top of the built-in `role`.
  customRoleId      String?
  customRole        CompanyRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  /// Extra powers given to this one person (e.g. "finance").
  permissions       String[]     @default([])
  /// When they confirmed their email (sign-up, step 7). Everyone from before has it set.
  emailVerifiedAt   DateTime?
  /// Signed up on their own and has not confirmed the email yet (only sign-up sets it).
  emailCheckPending Boolean      @default(false)
  /// Microsoft account id (sign in with Microsoft). Microsoft sign-in only opens accounts made with it.
  microsoftId       String?      @unique
  passwordHash      String? // null for SSO-only accounts
  googleId          String?      @unique
  name              String
  role              Role         @default(MEMBER)
  status            UserStatus   @default(ACTIVE)
  isActive          Boolean      @default(true)
  /// Sees System Health (error log, hourly checks) and gets its alerts. Super Admins see it too.
  isDeveloper       Boolean      @default(false)
  // Permanently remote: exempt from the office-network IP check-in restriction.
  attendanceRemote  Boolean      @default(false)
  // Sessions (JWTs) issued before this instant are rejected — bumped on disable,
  // password change, and admin password reset to revoke existing tokens.
  sessionsValidFrom DateTime?

  // Active context: the department/sub-department/role the user is currently
  // operating as. This mirrors one of their `memberships` rows; the department
  // switcher swaps it. Kept as scalar fields so every dept-scoped feature keeps
  // reading a single "current" department without change.
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  subDepartmentId String?
  subDepartment   SubDepartment? @relation(fields: [subDepartmentId], references: [id])

  // All departments this user belongs to, each with its own role + sub-department.
  memberships UserDepartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itadEntries     ItadDailyEntry[]
  leadGenEntries  LeadGenDailyEntry[]
  talkloopEntries TalkloopDailyEntry[]
  seoEntries      SeoDailyEntry[]
  socialEntries   SocialDailyEntry[]
  contentEntries  ContentDailyEntry[]
  marketingTasks  MarketingTask[]
  leaveDays       LeaveDay[]
  attendanceDays  AttendanceDay[]
  attendanceShift AttendanceShift?     @relation("UserShift")
  targets         Target[]             @relation("UserTargets")
  setTargets      Target[]             @relation("TargetSetBy")
  salaries        SalaryRecord[]       @relation("UserSalaries")
  setSalaries     SalaryRecord[]       @relation("SalarySetBy")
  auditLogs       AuditLog[]
  loginEvents     LoginEvent[]

  feedbackAuthored Feedback[]      @relation("FeedbackAuthored")
  feedbackReceived Feedback[]      @relation("FeedbackReceived")
  feedbackReplies  FeedbackReply[] @relation("FeedbackReplies")

  qaAuthored   QaEvaluation[] @relation("QaAuthored")
  qaReceived   QaEvaluation[] @relation("QaReceived")
  qaScorecards QaScorecard[]

  attachments EntryAttachment[]

  ecommerceEntries      EcommerceDailyEntry[]
  ecomTasksAssigned     EcommerceTask[]        @relation("EcomTaskAssignee")
  ecomTasksCreated      EcommerceTask[]        @relation("EcomTaskCreator")
  ecomTaskComments      EcomTaskComment[]      @relation("EcomCommentAuthor")
  marketingTaskComments MarketingTaskComment[] @relation("MarketingCommentAuthor")
  notifications         Notification[]         @relation("NotificationRecipient")
  notificationsActed    Notification[]         @relation("NotificationActor")
  stockAssignedTo       StockRequest[]         @relation("StockAssignee")
  stockAssignedBy       StockRequest[]         @relation("StockAssigner")
  stockCreated          StockRequest[]         @relation("StockCreator")
  supportTickets        SupportTicket[]        @relation("SupportTickets")
  inventoryItemsCreated InventoryItem[]        @relation("InvItemCreator")
  inventoryRequested    InventoryMovement[]    @relation("InvReqBy")
  inventoryAssignedTo   InventoryMovement[]    @relation("InvAssignee")
  inventoryAssignedBy   InventoryMovement[]    @relation("InvAssigner")

  todos                TodoItem[]
  meetingNotes         MeetingNote[]         @relation("MeetingNoteAuthor")
  bids                 Bid[]                 @relation("BidAgent")
  attendanceReminders  AttendanceReminder[]
  attendanceViolations AttendanceViolation[]

  brandSocialEntries    BrandSocialMonthly[] @relation("BrandSocialEnteredBy")
  blogPosts             BlogPost[]           @relation("BlogAuthor")
  marketingPlansCreated MarketingPlan[]      @relation("MarketingPlanCreatedBy")
  planItemsOwned        MarketingPlanItem[]  @relation("PlanItemOwner")
  adCampaignsCreated    AdCampaign[]         @relation("AdCampaignCreatedBy")
  brandsOwned           Brand[]              @relation("BrandOwner")
  brandProfilesOwned    BrandProfile[]       @relation("BrandProfileOwner")

  // Projects + chat
  pmProjectsOwned     PmProject[]          @relation("PmProjectOwner")
  pmMemberships       PmProjectMember[]    @relation("PmMemberships")
  pmTasksCreated      PmTask[]             @relation("PmTaskCreator")
  pmAssignments       PmTaskAssignee[]     @relation("PmAssignments")
  pmWatching          PmTaskWatcher[]      @relation("PmWatching")
  pmComments          PmComment[]          @relation("PmCommentAuthor")
  pmReviews           PmReview[]           @relation("PmReviewer")
  chatCallsStarted    ChatCall[]           @relation("ChatCallsStarted")
  /// Profile picture last changed (file: uploads/avatars/user-<id>.jpg).
  avatarAt            DateTime?
  meetingsOrganized   Meeting[]            @relation("MeetingsOrganized")
  meetingAttendance   MeetingAttendee[]    @relation("MeetingAttendance")
  pmAttachments       PmAttachment[]       @relation("PmAttachmentUploader")
  pmActivity          PmActivity[]         @relation("PmActivityActor")
  pmExtRequested      PmExtensionRequest[] @relation("PmExtRequester")
  pmExtDecided        PmExtensionRequest[] @relation("PmExtDecider")
  pmNotifyPref        PmNotifyPref?        @relation("PmNotifyPref")
  chatMemberships     ChatMember[]         @relation("ChatMemberships")
  chatMessagesSent    ChatMessage[]        @relation("ChatMessagesSent")
  pushSubscriptions   PushSubscription[]
  savedDocs           SavedDoc[]           @relation("SavedDocOwner")
  wfhRequests         WfhRequest[]         @relation("WfhRequester")
  wfhDecisions        WfhRequest[]         @relation("WfhDecider")
  dialerLeads         DialerLead[]         @relation("DialerLeadOwner")
  dialerImports       DialerImport[]       @relation("DialerImporter")
  dialerActions       DialerAction[]       @relation("DialerActor")
  dialerNotes         DialerNote[]         @relation("DialerNoteAuthor")
  dialerPrefs         DialerUserPrefs?     @relation("DialerPrefsOwner")
  dialerCalls         DialerCall[]         @relation("DialerCallAgent")
  workLogs            WorkLogEntry[]       @relation("WorkLogOwner")
  workLogReviews      WorkLogReview[]      @relation("WorkLogReviewOwner")
  workLogReviewsGiven WorkLogReview[]      @relation("WorkLogReviewer")
  blockedCheckIns     BlockedCheckIn[]
  workLogNotes        WorkLogNote[]        @relation("WorkLogNoteAuthor")
  claudeKeys          ClaudeKey[]
  reportForms         ReportForm[]         @relation("ReportFormCreator")
  reportEntries       ReportEntry[]        @relation("ReportEntries")

  @@index([companyId])
  @@index([departmentId])
  @@index([subDepartmentId])
}

/// A user's membership in a department, with the role (and optional Marketing
/// sub-department) they hold there. A user can belong to several departments;
/// their "active" one is mirrored onto User.department/subDepartment/role and
/// swapped by the department switcher (POST /api/auth/active-department).
model UserDepartment {
  id              String         @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId       String         @default("")
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id])
  subDepartmentId String?
  subDepartment   SubDepartment? @relation(fields: [subDepartmentId], references: [id])
  role            Role           @default(MEMBER)
  createdAt       DateTime       @default(now())

  @@unique([userId, departmentId])
  @@index([userId])
  @@index([departmentId])
  @@index([companyId])
}

// ---------- Daily-log file attachments (ITAD / Lead Gen) ----------

enum AttachmentKind {
  ITAD
  LEAD_GEN
  QA_RECORDING
  MARKETING_TASK // media/files attached to a marketing board card
}

/// A file an employee attaches to their daily log (Excel, Word, PDF, ...) or a board card.
/// Daily-log files are linked by user + kind + date; board-card files by taskId.
model EntryAttachment {
  id           String         @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String         @default("")
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  date         DateTime?      @db.Date // null for task attachments (not day-scoped)
  taskId       String? // set for MARKETING_TASK attachments
  task         MarketingTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  storedName   String // randomized filename on disk
  originalName String // name shown to the user
  mimeType     String
  size         Int
  createdAt    DateTime       @default(now())

  qaEvaluation QaEvaluation? // set when this attachment is a QA call recording

  @@index([userId, kind, date])
  @@index([taskId])
  @@index([companyId])
}

// ---------- ITAD daily entries (§4.1) ----------

model ItadDailyEntry {
  id        String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String    @default("")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  status    DayStatus @default(SUBMITTED)

  callsDialed Int @default(0)
  connected   Int @default(0)
  voicemail   Int @default(0)
  emailsSent  Int @default(0)
  interested  Int @default(0)
  workingOn   Int @default(0)
  closed      Int @default(0)
  rfqs        Int @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One entry per user per day — re-submitting upserts, never duplicates.
  @@unique([userId, date])
  @@index([date])
  @@index([companyId])
}

// ---------- Lead Gen daily entries (§5.1) ----------

model LeadGenDailyEntry {
  id        String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String    @default("")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  status    DayStatus @default(SUBMITTED)

  leadsGenerated     Int @default(0)
  accountsResearched Int @default(0)
  contactsFound      Int @default(0)
  qualifiedMql       Int @default(0)
  handedToSql        Int @default(0)

  dataSource String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  verticalCounts LeadGenVerticalCount[]

  @@unique([userId, date])
  @@index([date])
  @@index([companyId])
}

/// Leads-per-vertical breakdown for a Lead Gen entry (§5.1).
model LeadGenVerticalCount {
  id        String            @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String            @default("")
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entryId   String
  entry     LeadGenDailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag               @relation(fields: [tagId], references: [id])
  count     Int               @default(0)

  @@unique([entryId, tagId])
  @@index([companyId])
}

// ---------- Talkloop daily entries (outbound calls + demos, per-country) ----------

model TalkloopDailyEntry {
  id        String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String    @default("")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  status    DayStatus @default(SUBMITTED)

  callsMade      Int @default(0)
  connects       Int @default(0)
  demosScheduled Int @default(0)
  demosConducted Int @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countryCounts TalkloopCountryCount[]

  @@unique([userId, date])
  @@index([date])
  @@index([companyId])
}

/// Per-country calls + demos breakdown for a Talkloop entry.
model TalkloopCountryCount {
  id        String             @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String             @default("")
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entryId   String
  entry     TalkloopDailyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag                @relation(fields: [tagId], references: [id])
  calls     Int                @default(0)
  demos     Int                @default(0)

  @@unique([entryId, tagId])
  @@index([companyId])
}

// ---------- Team roster history (Team Lead invites / removals) ----------

/// An append-only log of team membership changes, scoped to a department.
/// Member name/email are snapshotted so history reads correctly over time.
model TeamMemberEvent {
  id           String        @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String        @default("")
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String
  actorId      String? // who performed the action (Team Lead / Admin)
  actorName    String
  memberId     String? // affected member
  memberName   String
  memberEmail  String
  type         TeamEventType
  createdAt    DateTime      @default(now())

  @@index([departmentId, createdAt])
  @@index([companyId])
}

// ---------- Tags (TL-managed lists: verticals, platforms, ...) ----------

model Tag {
  id           String      @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String      @default("")
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  type         TagType
  group        String? // for Ecommerce TASK_TYPE fields: the parent Type (Listings, Pricing, ...)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  verticalCounts        LeadGenVerticalCount[]
  socialCounts          SocialPlatformCount[]
  talkloopCountryCounts TalkloopCountryCount[]

  ecomTaskLines        EcommerceListingLine[] @relation("LineTaskType")
  ecomMarketplaceLines EcommerceListingLine[] @relation("LineMarketplace")

  @@unique([departmentId, type, name])
  @@index([companyId])
}

// ---------- Targets (§3) ----------

model Target {
  id        String       @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String       @default("")
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scope     TargetScope
  metricKey String // e.g. "callsDialed", "leadsGenerated", "connectRate"
  period    TargetPeriod
  value     Float // kept as the headline goal (= maxValue) for status/trend references
  minValue  Float? // acceptable lower bound of the target range
  maxValue  Float? // goal / upper bound of the target range

  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])
  subDepartmentId String?
  subDepartment   SubDepartment? @relation(fields: [subDepartmentId], references: [id])
  userId          String?
  user            User?          @relation("UserTargets", fields: [userId], references: [id])
  brandId         String?
  brand           Brand?         @relation(fields: [brandId], references: [id])

  setById       String?
  setBy         User?    @relation("TargetSetBy", fields: [setById], references: [id])
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([departmentId, metricKey])
  @@index([userId, metricKey])
  @@index([brandId, metricKey])
  @@index([companyId])
}

// ---------- Financials (Super Admin only): per-person cost vs revenue/ROI ----------

/// A person's monthly salary/cost, scoped to a team (department). Drives the
/// Financial Reports ROI: cost over a range = monthlyCost × active months.
/// `userId` optionally links to an app account; `name` is the display label.
model SalaryRecord {
  id           String     @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String     @default("")
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  userId       String?
  user         User?      @relation("UserSalaries", fields: [userId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  monthlyCost  Decimal    @db.Decimal(12, 2)
  startDate    DateTime   @db.Date
  endDate      DateTime?  @db.Date // null = still active
  note         String?

  setById   String?
  setBy     User?    @relation("SalarySetBy", fields: [setById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([userId])
  @@index([companyId])
}

// ---------- Leave / holidays (§3, leave-aware rule) ----------

/// Company-wide non-working days.
model Holiday {
  id        String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String   @default("")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  @@unique([companyId, date])
  @@index([companyId])
}

/// Per-user leave/off days (set by user or admin). Excluded from averages.
model LeaveDay {
  id        String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String    @default("")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  type      LeaveType @default(ON_LEAVE)
  note      String?
  createdAt DateTime  @default(now())

  @@unique([userId, date])
  @@index([date])
  @@index([companyId])
}

// ---------- Time & attendance (check-in / check-out / breaks) ----------

/// One attendance record per user per day. Check-in/out are full instants;
/// the `date` is the company-day bucket (companyToday). Worked/break minutes are
/// computed on read from these + the breaks, never stored.
model AttendanceDay {
  id             String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId      String    @default("")
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime  @db.Date
  checkInAt      DateTime?
  checkOutAt     DateTime?
  checkInIp      String? // client IP recorded at check-in (audit / office-network enforcement)
  checkOutIp     String?
  // Device audit (like LoginEvent): raw UA + the spoof-resistant client-mobile flag.
  checkInUa      String?
  checkInMobile  Boolean?
  checkOutUa     String?
  checkOutMobile Boolean?
  // Set when the person chose "Start overtime": they are not checked out when the shift's
  // hours are up, and the time after that counts as overtime.
  overtimeAt     DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  breaks BreakEntry[]

  @@unique([userId, date])
  @@index([date])
  @@index([companyId])
}

/// Admin-managed allowlist of office networks. A check-in/out is accepted only
/// from an IP inside one of these (unless the list is empty, or the caller is a
/// Super Admin). `cidr` accepts a bare IP (treated as /32) or CIDR range.
model OfficeNetwork {
  id        String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String   @default("")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String
  cidr      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// A check-in refused because the network was not on the office list. Shown to Super
/// Admins on Office Networks with one click to allow the address (or its whole range).
model BlockedCheckIn {
  id        String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String   @default("")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip])
  @@index([companyId])
}

enum ReminderKind {
  CHECK_IN
  CHECK_OUT
}

/// One row per (user, day, kind) once a reminder email has been sent — the
/// scheduler uses it to avoid sending duplicate check-in/out reminders.
model AttendanceReminder {
  id        String       @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String       @default("")
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  kind      ReminderKind
  sentAt    DateTime     @default(now())

  @@unique([userId, date, kind])
  @@index([date])
  @@index([companyId])
}

/// One row per (user, day, kind) violation — the dedupe ledger for break/grace
/// notifications AND the occurrence store used to count late sign-ins per month.
/// LATE_LIMIT rows use date = first-of-month (fire once per month).
model AttendanceViolation {
  id        String        @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String        @default("")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime      @db.Date
  kind      ViolationKind
  minutes   Int? // the offending duration (break/BRB minutes), or the count for LATE_LIMIT
  createdAt DateTime      @default(now())

  @@unique([userId, date, kind])
  @@index([userId, date])
  @@index([companyId])
}

/// A single break within an attendance day. `endAt` null = break still open.
model BreakEntry {
  id          String        @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId   String        @default("")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dayId       String
  day         AttendanceDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  type        BreakType     @default(BREAK)
  startAt     DateTime
  endAt       DateTime?
  // Device audit — captured on break start and (separately) on break end.
  startUa     String?
  startMobile Boolean?
  endUa       String?
  endMobile   Boolean?
  /// Ended by the break cut-off (the person forgot to end it).
  autoEnded   Boolean       @default(false)
  /// Added or changed by a team lead (who and when; details in the activity log).
  editedById  String?
  editedAt    DateTime?
  createdAt   DateTime      @default(now())

  @@index([dayId])
  @@index([companyId])
}

/// Expected working hours that drive the late / early-leave / shift-completion
/// flags. Resolution order per employee: user override → department → company.
/// A row is one of: company default (both ids null), a department row
/// (departmentId set), or a per-account override (userId set).
model AttendanceShift {
  id                String      @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId         String      @default("")
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId      String?     @unique
  department        Department? @relation(fields: [departmentId], references: [id])
  userId            String?     @unique
  user              User?       @relation("UserShift", fields: [userId], references: [id], onDelete: Cascade)
  startTime         String // "HH:mm" in the shift's timezone, e.g. "09:00"
  endTime           String // "HH:mm", e.g. "18:00". If <= startTime the shift crosses midnight (overnight).
  // Optional per-weekday start/end overrides: { "1": { startTime, endTime }, ... }
  // (0=Sun..6=Sat). Weekdays absent here use the base startTime/endTime above.
  dayTimes          Json?
  graceMin          Int         @default(10)
  requiredMinutes   Int         @default(480) // full-shift target; worked >= this = shift completed
  brbAllowanceMin   Int         @default(20) // total BRB minutes allowed per day
  breakAllowanceMin Int         @default(65) // total regular break minutes allowed per day (1h05m)
  /// A single break still running after this many minutes is ended at that point (someone forgot
  /// to end it); 0 = never. Team leads get an alert and can fix the time.
  breakCutoffMin    Int         @default(90)
  brbCutoffMin      Int         @default(30)
  workingDays       Int[]       @default([1, 2, 3, 4, 5]) // 0=Sun … 6=Sat; which weekdays are worked
  timeZone          String? // IANA tz (e.g. "America/New_York"); null = company timezone
  updatedAt         DateTime    @updatedAt

  @@index([companyId])
}

// ---------- RDP inventory & assignment history (Ecommerce/CSR/Shipping) ----------

/// Which team an RDP belongs to (tabs in the source spreadsheet).
enum RdpTeam {
  EC
  CSR
  SHIPPING
}

/// A remote machine identified by provider + address (an IP or an Anydesk ID).
/// One RDP can be used by several agents; usage over time lives in assignments.
model Rdp {
  id        String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String   @default("")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team      RdpTeam
  provider  String // Sj Computers, MaxE Computers, Anydesk, ...
  address   String // IP address or Anydesk ID (free text)
  label     String?
  notes     String?
  active    Boolean  @default(true) // false = retired
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments RdpAssignment[]

  @@unique([companyId, provider, address])
  @@index([team])
  @@index([companyId])
}

/// A period an agent used an RDP. `unassignedAt` null = currently assigned.
/// Agent is stored by name (snapshot) so history survives staff changes.
model RdpAssignment {
  id           String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String    @default("")
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rdpId        String
  rdp          Rdp       @relation(fields: [rdpId], references: [id], onDelete: Cascade)
  agentName    String
  assignedAt   DateTime  @default(now())
