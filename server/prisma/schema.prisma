// ---------- Inventory Management (Operations team) ----------

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
}

enum InventoryReqStatus {
  REQUESTED
  ASSIGNED
  COMPLETED
  CANCELLED
}

/// A tracked stock item (shared list, department = INVENTORY). quantity = live on-hand.
/// `category` is one of the shared INVENTORY_CATEGORIES; `active` drives the
/// Active/Inactive toggle column. Item field edits are recorded in AuditLog
/// (entityType "InventoryItem") so they appear in the per-item activity timeline.
model InventoryItem {
  id            String     @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId     String     @default("")
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  name          String
  category      String
  active        Boolean    @default(true)
  quantity      Int        @default(0)
  price         Decimal?   @db.Decimal(12, 2)
  previousPrice Decimal?   @db.Decimal(12, 2) // last price before the current one (shown in the Price column)
  lowStockAt    Int        @default(0)
  sku           String?
  unit          String?
  location      String?
  notes         String?
  createdById   String?
  createdBy     User?      @relation("InvItemCreator", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  movements InventoryMovement[]

  @@index([departmentId])
  @@index([category])
  @@index([companyId])
}

/// A stock-in / stock-out request against an item. Doubles as the per-item
/// activity log. Quantity is applied to the item only when status = COMPLETED.
model InventoryMovement {
  id              String                @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId       String                @default("")
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemId          String
  item            InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type            InventoryMovementType
  quantity        Int                   @default(1)
  status          InventoryReqStatus    @default(REQUESTED)
  requestedById   String?
  requestedBy     User?                 @relation("InvReqBy", fields: [requestedById], references: [id])
  requestedByName String?
  note            String?
  assignedToId    String?
  assignedTo      User?                 @relation("InvAssignee", fields: [assignedToId], references: [id])
  assignedById    String?
  assignedBy      User?                 @relation("InvAssigner", fields: [assignedById], references: [id])
  requestedAt     DateTime              @default(now())
  assignedAt      DateTime?
  resolvedAt      DateTime?

  @@index([itemId])
  @@index([status])
  @@index([companyId])
}

// Personal, private to-do list — one owner, not shared. Every user gets one.
