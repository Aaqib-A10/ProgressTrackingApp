// Ecommerce meeting notes — shared across the department. Author edits/deletes
// their own; TL / Super Admin can manage any. meetingDate defaults to "today"
// (auto submission date); deadline is optional.
model MeetingNote {
  id           String      @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String      @default("")
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorId     String
  author       User        @relation("MeetingNoteAuthor", fields: [authorId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  title        String
  body         String
  meetingDate  DateTime    @db.Date
  deadline     DateTime?   @db.Date
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([departmentId, meetingDate])
  @@index([companyId])
}

// ---------- ITAD Bid Tracker ----------

enum BidType {
  RFQ
  RFP
  BID
  PO // Purchase Order
}

enum BidStatus {
  ACTIVE // Active Opportunity (default)
  SUBMITTED
  WON
  LOST
}

enum BidSubmissionType {
  PHYSICAL
  EMAIL
  PORTAL
}

/// An ITAD sales bid / opportunity. agentId is the submitting user; awardedPrice
/// is required once status = WON.
model Bid {
  id             String             @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId      String             @default("")
  owningCompany  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number         Int                @unique @default(autoincrement()) // human-facing bid_id
  title          String
  company        String
  type           BidType
  district       String?
  agentId        String
  agent          User               @relation("BidAgent", fields: [agentId], references: [id])
  departmentId   String? // the agent's department (ITAD) — scopes team-wide views
  department     Department?        @relation(fields: [departmentId], references: [id])
  status         BidStatus          @default(ACTIVE)
  dueDate        DateTime // date & time
  reminderSet    Boolean            @default(false)
  submissionType BidSubmissionType?
  priceQuoted    Decimal?           @db.Decimal(12, 2)
  awardedPrice   Decimal?           @db.Decimal(12, 2) // required when status = WON
  bidBond        Boolean            @default(false) // whether a bid bond applies
  bidBondAmount  Decimal?           @db.Decimal(12, 2) // optional bid bond value (only meaningful when bidBond)
  closedDate     DateTime? // date the deal was decided (WON/LOST) — drives financial revenue period + Deal Tracker date filter
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([departmentId, status])
  @@index([agentId])
  @@index([dueDate])
  @@index([status, closedDate])
  @@index([companyId])
}

// ========== Projects (project management) + Team Chat ==========
// Per-project Kanban boards with membership-based visibility, task assignment,
// due/overdue alerts and team chat. All models are prefixed Pm/Chat so they never
// collide with the Marketing/Ecommerce board models above.

enum PmProjectStatus {
  ACTIVE
  ARCHIVED
}

/// Role a user holds inside ONE project (separate from their global Role).
enum PmProjectRole {
  ADMIN // manages members, columns, settings; edits any task; gets overdue alerts
  MEMBER // creates/assigns/moves tasks
  VIEWER // read only (can comment + chat)
}

/// Column category drives completion + overdue logic and reporting.
enum PmColumnCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum PmExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChatConversationType {
  DIRECT
  GROUP
  PROJECT
}

model PmProject {
  id                     String          @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId              String          @default("")
  company                Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                   String
  key                    String // 2-6 uppercase chars, used in task codes (RTI-12); one per company
  description            String?
  color                  String          @default("#4F46E5")
  status                 PmProjectStatus @default(ACTIVE)
  ownerId                String
  owner                  User            @relation("PmProjectOwner", fields: [ownerId], references: [id])
  taskCounter            Int             @default(0)
  overdueNotifyAdmins    Boolean         @default(true)
  overdueRepeatHours     Int             @default(24)
  reminderOffsetsMinutes Int[]           @default([1440, 60])
  /// Project picture last changed (also the project chat's picture).
  avatarAt               DateTime?
  /// Who last changed the picture (shown in the chat).
  avatarById             String?
  /// Where the work for this project lives (a folder, a GitHub repo, a link). Shown to Claude
  /// with each ticket so it knows where to make the change.
  workFolder             String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  members      PmProjectMember[]
  columns      PmColumn[]
  tasks        PmTask[]
  labels       PmLabel[]
  conversation ChatConversation?
  meetings     Meeting[]

  @@unique([companyId, name])
  @@unique([companyId, key])
  @@index([status])
  @@index([companyId])
}

model PmProjectMember {
  id        String        @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String        @default("")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId String
  project   PmProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("PmMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role      PmProjectRole @default(MEMBER)
  addedById String?
  createdAt DateTime      @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([companyId])
}

model PmColumn {
  id        String           @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String           @default("")
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId String
  project   PmProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  category  PmColumnCategory @default(TODO)
  position  Int              @default(0)
  color     String?
  wipLimit  Int?
  isDefault Boolean          @default(false)
  createdAt DateTime         @default(now())

  tasks PmTask[]

  @@index([projectId, position])
  @@index([companyId])
}

model PmTask {
  id                    String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId             String    @default("")
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId             String
  project               PmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code                  String // e.g. RTI-142; one per company
  title                 String
  description           String?
  columnId              String
  column                PmColumn  @relation(fields: [columnId], references: [id])
  position              Float     @default(0) // rank within the column (midpoint ordering)
  priority              Priority  @default(MEDIUM)
  createdById           String
  createdBy             User      @relation("PmTaskCreator", fields: [createdById], references: [id])
  startAt               DateTime?
  dueAt                 DateTime?
  completedAt           DateTime?
  estimateHours         Float?
  isOverdue             Boolean   @default(false)
  overdueSince          DateTime?
  lastOverdueNotifiedAt DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assignees         PmTaskAssignee[]
  watchers          PmTaskWatcher[]
  labels            PmTaskLabel[]
  checklist         PmChecklistItem[]
  comments          PmComment[]
  reviews           PmReview[]
  attachments       PmAttachment[]
  activity          PmActivity[]
  extensionRequests PmExtensionRequest[]
  dispatches        PmDispatchLog[]
  chatRefs          ChatMessage[]

  @@unique([companyId, code])
  @@index([projectId, columnId, position])
  @@index([dueAt])
  @@index([isOverdue])
  @@index([createdById])
  @@index([companyId])
}

model PmTaskAssignee {
  id           String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String   @default("")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId       String
  task         PmTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("PmAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedAt   DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
  @@index([companyId])
}

model PmTaskWatcher {
  id        String  @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String  @default("")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId    String
  task      PmTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("PmWatching", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([companyId])
}

model PmLabel {
  id        String        @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String        @default("")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId String
  project   PmProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
