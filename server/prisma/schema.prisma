  createdBy       User?       @relation("StockCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Last edit (the full history is in the activity log).
  editedAt        DateTime?
  editedById      String?
  requestedAt     DateTime    @default(now())
  status          StockStatus @default(REQUESTED)

