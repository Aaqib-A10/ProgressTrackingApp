  backlinksBuilt  Int @default(0)
  technicalFixes  Int @default(0)
  organicTraffic  Int @default(0) // manually entered key figure (GSC/GA4 integration later)

  body      String? // free-text SEO daily log (metric columns retained but no longer surfaced)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([companyId])
}

// ---------- Content daily activity (free-text log) ----------
model ContentDailyEntry {
  id        String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
