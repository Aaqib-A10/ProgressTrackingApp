model PlatformOwner {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  /// Optional short sign in name (e.g. the local test owner), used instead of the email.
  username     String?   @unique
  passwordHash String
  /// Authenticator app key (base32). When set, sign in also needs a 6 digit code from it.
  /// Empty = password only (turn the code on with: owner.ts code-on).
  totpSecret   String?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  /// Sessions signed before this are dead (set by the reset command).
  sessionsFrom DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  actions OwnerAuditLog[]
}

/// Every owner action and every owner sign in (good or bad), kept for good.
model OwnerAuditLog {
  id        String         @id @default(cuid())
  ownerId   String?
  owner     PlatformOwner? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  action    String // "LOGIN", "LOGIN_FAILED", "LOCKED", "COMPANY_UPDATE", "TICKET_REPLY", ...
  companyId String?
  target    String?
  detail    Json?
  ip        String?
  createdAt DateTime       @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_COMPANY
  RESOLVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id         String         @id @default(cuid())
  number     Int            @unique @default(autoincrement())
  companyId  String         @default("")
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?          @relation("SupportTickets", fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  userEmail  String
  subject    String
  body       String
  /// Where they were and what they were using, captured by the Help button.
  pageUrl    String?
  userAgent  String?
  /// Errors this person hit in the 24 hours before (System Health error groups).
  errorIds   String[]
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(NORMAL)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  resolvedAt DateTime?

  messages SupportMessage[]

  @@index([companyId, status])
  @@index([status, updatedAt(sort: Desc)])
}

model SupportMessage {
  id         String        @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId  String        @default("")
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromOwner  Boolean
  authorName String
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([companyId])
}

/// Settings for the whole of Metriq that the owner keeps in the owner console (not secrets: keys
/// stay in the server's .env). Example: "seller", the business name, address and tax ID printed on
/// every invoice.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// On/off switches for new parts of Metriq (Phase 1, step 1). A switch with no row uses its
/// default from lib/flags.ts. The owner flips them in the owner console; no deploy needed.
model FeatureFlag {
  key       String   @id
  enabled   Boolean
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// A switch set differently for one company (show a part to some companies and not others).
/// No row = the company follows the switch's setting for all companies.
model FeatureFlagCompany {
  key       String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enabled   Boolean
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@id([key, companyId])
  @@index([companyId])
}

/// A role a company made itself (Phase 1, step 4): a name, the built-in role it starts from
/// (what it can do everywhere), parts of Metriq switched off for it, and extra powers.
model CompanyRole {
  id        String   @id @default(cuid())
  companyId String   @default("")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  baseRole  Role
  /// Parts of Metriq (lib/permissions AREAS) people with this role do not see.
  areasOff  String[] @default([])
  /// Extra powers (lib/permissions POWERS), e.g. "finance", "company.settings".
  powers    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@unique([companyId, name])
  @@index([companyId])
}

// ---------------------------------------------------------------- Daily Report builder
// Phase 1, step 5: a company builds its own daily form instead of the six built-in daily logs.

enum ReportFieldType {
  NUMBER
  TEXT
  LONG_TEXT
  CHOICE
  MULTI_CHOICE
  YES_NO
  RATING
  LINK
}

/// A daily form a company built (for one department, or for everyone).
model ReportForm {
  id           String      @id @default(cuid())
  companyId    String      @default("")
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Who fills it in: the people of this department (empty = everyone in the company).
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String
  description  String?
  active       Boolean     @default(true)
  createdById  String?
  createdBy    User?       @relation("ReportFormCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  fields  ReportField[]
  entries ReportEntry[]

  @@index([companyId])
  @@index([departmentId])
}

/// One question on a daily form. Removing a question archives it, so old answers keep their meaning.
model ReportField {
  id        String          @id @default(cuid())
  companyId String          @default("")
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  formId    String
  form      ReportForm      @relation(fields: [formId], references: [id], onDelete: Cascade)
  label     String
  help      String?
  type      ReportFieldType
  /// Choices (CHOICE, MULTI_CHOICE).
  options   String[]        @default([])
  required  Boolean         @default(false)
  /// NUMBER: the daily target per person, and whether more (MIN) or less (MAX) is better.
  target    Float?
  targetDir String          @default("MIN")
  unit      String?
  position  Int             @default(0)
  archived  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([formId, position])
  @@index([companyId])
}

/// A person's answers for one day (one per person, form and day; sending again updates it).
model ReportEntry {
  id          String     @id @default(cuid())
  companyId   String     @default("")
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  formId      String
  form        ReportForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation("ReportEntries", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  /// { [fieldId]: number | string | string[] | boolean }
  values      Json
  submittedAt DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([formId, userId, date])
  @@index([formId, date])
  @@index([companyId])
  @@index([userId, date])
}

/// What a company used each month (AI meeting notes), for its plan's limits (Phase 1, step 6).
model CompanyUsage {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month     String // "YYYY-MM"
  aiSeconds Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([companyId, month])
}

// ---------------------------------------------------------------- Billing (Phase 1, step 8)
// One subscription per company, with Stripe, Paddle or the built-in test provider (keys only on
// the server). 99 Technologies (internal plan) is never billed.

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  OPEN
  PAID
  FAILED
  VOID
}

model Subscription {
  id                String             @id @default(cuid())
  companyId         String             @unique @default("")
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// "test", "stripe" or "paddle"
  provider          String
  externalId        String?
  customerId        String?
  plan              String
  /// "month" or "year"
  interval          String
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean            @default(false)
  /// The first failed payment of a run of failures (7 days to fix it).
  pastDueSince      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([provider, externalId])
}

model Invoice {
  id          String        @id @default(cuid())
  companyId   String        @default("")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      Int           @unique @default(autoincrement())
  provider    String
  externalId  String?
  plan        String
  interval    String
  currency    String        @default("USD")
  amountCents Int
  taxCents    Int           @default(0)
  status      InvoiceStatus
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  /// The provider's own page for this invoice (with tax details), when it has one.
  hostedUrl   String?
  createdAt   DateTime      @default(now())

  @@unique([provider, externalId])
  @@index([companyId, createdAt(sort: Desc)])
}

/// Every message from a payment provider, kept once (a provider can send the same one twice).
model BillingEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  type        String
  companyId   String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, externalId])
  @@index([receivedAt])
}
