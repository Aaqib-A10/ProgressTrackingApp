  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  itemName        String
  /// How many units (optional; E-commerce, Oct 2026).
  quantity        Int?
  requestedByName String // free text — operations person (outside the app)
  note            String?
  /// Who logged it in Metriq (null for logs made before Oct 2026).
