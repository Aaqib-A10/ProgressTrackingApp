  uploadedById String
  uploadedBy   User     @relation("PmAttachmentUploader", fields: [uploadedById], references: [id])
  storedName   String
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([companyId])
}

/// Append-only audit trail for a task (who changed what, when).
model PmActivity {
  id        String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String   @default("")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId    String
  task      PmTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation("PmActivityActor", fields: [userId], references: [id], onDelete: SetNull)
  action    String // created, status_changed, assigned, due_changed, became_overdue, ...
  meta      Json?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([companyId])
}

model PmExtensionRequest {
  id             String            @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId      String            @default("")
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId         String
  task           PmTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User              @relation("PmExtRequester", fields: [requestedById], references: [id])
  currentDueAt   DateTime?
  requestedDueAt DateTime
  reason         String
  status         PmExtensionStatus @default(PENDING)
  decidedById    String?
  decidedBy      User?             @relation("PmExtDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime          @default(now())

  @@index([taskId, status])
  @@index([companyId])
}

/// Idempotency log for the deadline cron: one row per (task, user, kind, due snapshot)
/// so a reminder is never sent twice, and changing the due date re-arms reminders.
model PmDispatchLog {
  id            String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId     String   @default("")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId        String
  task          PmTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  kind          String // due_soon_1440, due_soon_60, overdue_first, overdue_repeat_<n>
  dueAtSnapshot DateTime
  sentAt        DateTime @default(now())

  @@unique([taskId, userId, kind, dueAtSnapshot])
  @@index([companyId])
}

/// Per-user email preferences for project + chat notifications (in-app is always on).
model PmNotifyPref {
  userId        String   @id
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId     String   @default("")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User     @relation("PmNotifyPref", fields: [userId], references: [id], onDelete: Cascade)
  emailAssigned Boolean  @default(true)
  emailMention  Boolean  @default(true)
  emailComment  Boolean  @default(false)
  emailDueSoon  Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@index([companyId])
}

model ChatConversation {
  id            String               @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId     String               @default("")
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          ChatConversationType
  projectId     String?              @unique
  project       PmProject?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String?
  directKey     String?              @unique // "<userA>:<userB>" sorted, for DIRECT de-dupe
  createdById   String?
  lastMessageAt DateTime             @default(now())
  /// Group chat picture last changed, and by whom.
  avatarAt      DateTime?
  avatarById    String?
  /// Secret part of the link that lets people outside Metriq ask to join this chat's calls (null = off).
  guestToken    String?              @unique
  createdAt     DateTime             @default(now())

  members  ChatMember[]
  messages ChatMessage[]
  calls    ChatCall[]
  meetings Meeting[]

  @@index([lastMessageAt])
  @@index([companyId])
}

/// A voice or video call in a conversation (media is browser to browser; the server only connects people).
model ChatCall {
  id             String               @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId      String               @default("")
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   ChatConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  startedById    String
  startedBy      User                 @relation("ChatCallsStarted", fields: [startedById], references: [id])
  video          Boolean              @default(true)
  startedAt      DateTime             @default(now())
  endedAt        DateTime?
  /// Everyone who joined at some point (for the "Call ended" summary).
  joinedIds      String[]
  messages       ChatMessage[]
  meetingId      String?
  meeting        Meeting?             @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  /// AI note taker: was it switched on, and the generated notes.
  noteTaker      Boolean              @default(false)
  notesStatus    String? // pending | ready | failed | empty | no-ai
  notesStartedAt DateTime? // when the notes started being written (a stuck run can be retried)
  notes          Json?
  transcript     CallTranscriptLine[]
  recordings     CallRecording[]

  @@index([conversationId, endedAt])
  @@index([meetingId])
  @@index([companyId])
}

/// One spoken sentence in a call (each person's browser transcribes their own microphone).
model CallTranscriptLine {
  id          String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId   String   @default("")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  callId      String
  call        ChatCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId      String
  speakerName String
  text        String
  /// The same words in English. Null until translated.
  textEn      String?
  /// The same words in Roman Urdu (Urdu in English letters, as people type it). Shown by default.
  textRoman   String?
  at          DateTime @default(now())

  @@index([callId, at])
  @@index([companyId])
}

/// A recording of a call, uploaded in chunks while it is being made.
model CallRecording {
  id          String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId   String   @default("")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  callId      String
  call        ChatCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId      String
  storedName  String
  mime        String
  size        Int      @default(0)
  chunks      Int      @default(0)
  durationSec Int?
  status      String   @default("uploading") // uploading | ready | failed
  messageId   String?
  createdAt   DateTime @default(now())

  @@index([callId])
  @@index([companyId])
}

/// Emoji reaction on a chat message.
model ChatReaction {
  id        String      @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String      @default("")
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([companyId])
}

/// A scheduled meeting. Each meeting (or repeating series) has its own group chat.
model Meeting {
  id             String           @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId      String           @default("")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  agenda         String           @default("")
  startsAt       DateTime
  endsAt         DateTime
  organizerId    String
  organizer      User             @relation("MeetingsOrganized", fields: [organizerId], references: [id])
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        PmProject?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Same id on every occurrence of a repeating meeting.
  seriesId       String?
  repeat         String? // daily | weekdays | weekly
  /// Start the AI note taker automatically when this meeting's call starts.
  autoNotes      Boolean          @default(true)
  cancelledAt    DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attendees MeetingAttendee[]
  calls     ChatCall[]

  @@index([startsAt])
  @@index([seriesId])
  @@index([conversationId])
  @@index([companyId])
}

model MeetingAttendee {
  id        String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String   @default("")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MeetingAttendance", fields: [userId], references: [id], onDelete: Cascade)
  response  String   @default("PENDING") // PENDING | ACCEPTED | TENTATIVE | DECLINED
  createdAt DateTime @default(now())

  @@unique([meetingId, userId])
  @@index([userId])
  @@index([companyId])
}

model ChatMember {
  id             String           @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId      String           @default("")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("ChatMemberships", fields: [userId], references: [id], onDelete: Cascade)
  isAdmin        Boolean          @default(false)
  lastReadSeq    Int              @default(0) // seq of the last message this member has read
  lastReadAt     DateTime?
  mutedUntil     DateTime?
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([companyId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId      String           @default("")
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seq            Int              @default(autoincrement()) // monotonic cursor for polling + unread
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("ChatMessagesSent", fields: [userId], references: [id])
  body           String
  mentions       String[]
  replyToId      String?
  replyTo        ChatMessage?     @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]    @relation("ChatReplies")
  taskRefId      String?
  taskRef        PmTask?          @relation(fields: [taskRefId], references: [id], onDelete: SetNull)
  callId         String?
  call           ChatCall?        @relation(fields: [callId], references: [id], onDelete: SetNull)
  /// "Meeting notes are ready" card for this call.
  notesCallId    String?
  /// Bumped whenever an emoji reaction changes, so open chats refresh the message.
  reactedAt      DateTime?
  /// A line from the app itself ("Aqib changed this channel's picture"), shown in the middle.
  system         String?
  reactions      ChatReaction[]
  // Optional single file per message (stored like other uploads)
  fileStoredName String?
  fileName       String?
  fileMime       String?
  fileSize       Int?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())

  @@unique([seq])
  @@index([conversationId, seq])
  @@index([companyId])
}

/// A browser / phone that gets pop-up notifications even when PulseTrack is closed (Web Push).
model PushSubscription {
  id        String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String    @default("")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime  @default(now())
  lastOkAt  DateTime?

  @@index([userId])
  @@index([companyId])
}

/// Keys the server makes for itself once and keeps (e.g. the Web Push key pair).
model AppSecret {
  name      String   @id
  value     String
  createdAt DateTime @default(now())
}

/// A person's own saved documents and links (Docs & Links): only they can see them.
model SavedDoc {
  id             String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId      String   @default("")
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation("SavedDocOwner", fields: [userId], references: [id], onDelete: Cascade)
  title          String
  url            String? // a link, or
  // an uploaded file (stored in uploads/docs)
  fileStoredName String?
  fileName       String?
  fileMime       String?
  fileSize       Int?
  brand          String? // brand / company it belongs to
  category       String   @default("OTHER") // CONTRACT | PRICE_LIST | CERTIFICATE | PROPOSAL | PORTAL | SOP | OTHER
  notes          String?
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, pinned, updatedAt])
  @@index([companyId])
}

enum WfhRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// An employee asks their Team Lead to work from home on some dates. Approved -> those working
/// days are marked Work From Home (LeaveDay WFH), so check-in works from any network.
model WfhRequest {
  id           String           @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String           @default("")
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("WfhRequester", fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime         @db.Date
  endDate      DateTime         @db.Date
  /// The working days in the range, worked out when the request was made (yyyy-MM-dd).
  days         String[]
  reason       String
  status       WfhRequestStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?            @relation("WfhDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime         @default(now())

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([companyId])
}

/// ---------------------------------------------------------------------------
/// Lead Dialer (ITAD, Oct 2026). Reps export their own leads from the CRM and import them
/// here; the dashboard shows who can be called now (US regions open from Pakistan at night),
/// where leads are stuck, follow-ups that went quiet, and the funnel. Each rep sees only their
/// own leads. History, snoozes and notes live here and survive every import.
/// ---------------------------------------------------------------------------

model DialerLead {
  id              String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId       String    @default("")
  owningCompany   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User      @relation("DialerLeadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// The value used to recognise the lead between imports: CRM lead ID, else email, else company + phone.
  matchKey        String
  externalId      String?
  company         String
  contactName     String?
  email           String?
  phone           String?
  city            String?
  stateRaw        String?
  /// Full state name, cleaned on import (CA and California are the same). Null = unknown.
  state           String?
  /// A state filled in on the dashboard (Fix data). Used until the CRM sends a state itself.
  stateOverride   String?
  /// ET, CT, MT, PT, or AZ (Arizona: Pacific hours in US summer, Mountain in winter).
  region          String?
  /// The state sits in two time zones: the city or area code settles it.
  verifyZone      Boolean   @default(false)
  /// Region picked by the rep for a split-state lead.
  zoneOverride    String?
  industry        String?
  /// From the CRM export when mapped.
  website         String?
  companySize     String?
  /// Which list the lead came from: "CRM" (the SMB export) or another list the rep imports (Vendors...).
  listName        String    @default("CRM")
  status          String
  stage           Int
  /// Highest stage this lead has ever reached (for "ever reached" funnel counts).
  maxStage        Int
  source          String?
  /// Created / assigned date from the export, if mapped.
  leadDate        DateTime?
  /// Last activity / modified date from the export, if mapped.
  lastActivityAt  DateTime?
  /// When the dashboard saw the status change (between two imports).
  statusChangedAt DateTime?
  /// In the rep's latest import. Leads that dropped out of the export are kept but hidden.
  inLatestImport  Boolean   @default(true)
  /// Another rep already holds this lead: waits for a manager, kept out of the counts.
  duplicate       Boolean   @default(false)
  /// A manager decided another rep keeps this lead (it stays hidden from this rep's counts).
  dupResolved     Boolean   @default(false)
  sentToLeadGen   Boolean   @default(false)
  snoozeUntil     DateTime?
  callLaterAt     DateTime?
  lastActionAt    DateTime?
  raw             Json?
  /// Added here (never touched by an import): extra contact details the rep keeps in the dialer.
  phone2          String?
  email2          String?
  linkedin        String?
  decisionMaker   String?
  bestTime        String?
  tags            String[]  @default([])
  /// Something added here should also go into Earthzone (the CRM); cleared with "Done in Earthzone".
  needsCrmUpdate  Boolean   @default(false)
  crmUpdateWhat   String?
  /// Follow-up tracker: dropped from follow-ups (until the status changes), or kept in the 90+ day backlog.
  followUpDropped Boolean   @default(false)
  backlogKeptAt   DateTime?
  firstImportId   String?
  lastImportId    String?
  /// Status changed in Metriq by a rep (or manager), waiting for Earthzone: while an import still
  /// brings the old CRM status (statusHereFrom), Metriq keeps statusHere. Cleared once the CRM
  /// shows it, or shows any other status (the CRM moved on).
  statusHere      String?
  statusHereFrom  String?
  statusHereAt    DateTime?
  /// From the predictive dialer (never touched by an import): never dial this lead again.
  doNotCall       Boolean   @default(false)
  doNotCallAt     DateTime?
  /// From the predictive dialer: the number is wrong; kept out of dialing until the phone changes.
  wrongNumber     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  actions DialerAction[]
  changes DialerStatusChange[]
  notes   DialerNote[]
  calls   DialerCall[]

  @@unique([ownerId, matchKey])
  @@index([matchKey])
  @@index([ownerId, inLatestImport])
  @@index([companyId])
}

model DialerImport {
  id              String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId       String   @default("")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("DialerImporter", fields: [userId], references: [id], onDelete: Cascade)
  fileName        String
  /// The file's column names, joined: a change is flagged before the next import.
  headerSignature String
  mapping         Json
  rowCount        Int
  /// Added / changed / unchanged / new industries / moved forward or back / top changes / warnings.
  summary         Json
  /// The rep's funnel after this import (funnel history).
  funnel          Json
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([companyId])
}

/// Change log: every status change per lead, kept for good.
model DialerStatusChange {
  id         String     @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId  String     @default("")
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId     String
  lead       DialerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  fromStage  Int?
  toStage    Int
  importId   String?
  /// Who changed it in Metriq (empty for an import or the predictive dialer).
  byName     String?
  createdAt  DateTime   @default(now())

  @@index([leadId, createdAt])
  @@index([companyId])
}

/// What a rep did on the dashboard: Call now, Call later, Snooze, Log note, state fixed, back to lead gen.
model DialerAction {
  id        String     @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String     @default("")
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId    String
  lead      DialerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("DialerActor", fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  note      String?
  at        DateTime?
  createdAt DateTime   @default(now())

  @@index([leadId, createdAt])
  @@index([companyId])
}

/// A note on a lead: author, time, pinned, edited, optional next-action date (feeds follow-ups).
model DialerNote {
  id           String     @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String     @default("")
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadId       String
  lead         DialerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("DialerNoteAuthor", fields: [userId], references: [id], onDelete: Cascade)
  text         String
  pinned       Boolean    @default(false)
  nextActionAt DateTime?
  editedAt     DateTime?
  createdAt    DateTime   @default(now())

  @@index([leadId, createdAt])
  @@index([userId, createdAt])
  @@index([companyId])
}

/// Each rep's own dialer settings: saved views (filter sets) and follow-up alert days (3 to 60).
model DialerUserPrefs {
  userId    String   @id
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String   @default("")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation("DialerPrefsOwner", fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

/// A predictive dialer sending call results to Metriq (Oct 2026). The dialer calls a private link
/// after every call; Metriq finds the lead, logs the call and updates the lead.
model DialerIntegration {
  id             String       @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId      String       @default("")
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  tokenHash      String       @unique
  /// First characters of the link's key, to tell links apart.
  prefix         String
  enabled        Boolean      @default(true)
  /// Which field in the dialer's message holds what (phone, lead id, disposition...); blank = guess.
  fieldMap       Json
  /// The dialer's disposition codes → a Metriq outcome (CONNECTED, NO_ANSWER, VOICEMAIL...).
  dispositionMap Json
  /// The dialer's agent ids → Metriq people.
  agentMap       Json
  createdById    String
  lastReceivedAt DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  calls          DialerCall[]

  @@index([companyId])
}

/// One call reported by the predictive dialer, matched to a lead (or waiting to be matched).
model DialerCall {
  id             String            @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId      String            @default("")
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integrationId  String
  integration    DialerIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// The dialer's own id for the call, so the same call sent twice is logged once.
  externalCallId String
  leadId         String?
  lead           DialerLead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  /// How the lead was found: lead_id, crm_id, phone or manual (linked by a manager).
  matchedBy      String?
  agentId        String?
  agent          User?             @relation("DialerCallAgent", fields: [agentId], references: [id], onDelete: SetNull)
  /// The agent as the dialer named them.
  agentRaw       String?
  phone          String?
  disposition    String
  /// The Metriq outcome the disposition maps to; null = not mapped (logged only).
  outcome        String?
  notes          String?
  durationSec    Int?
  calledAt       DateTime
  callbackAt     DateTime?
  /// What changed on the lead ("Contact Attempted → Voicemail Sent", "call back set"...).
  effect         String?
  /// The message as received (cut short), to check mappings.
  payload        Json?
  createdAt      DateTime          @default(now())

  @@unique([integrationId, externalCallId])
  @@index([leadId, calledAt])
  @@index([integrationId, createdAt])
  @@index([companyId])
}

/// One row ("default"): stage map, follow-up rules, highlight thresholds, calling slots.
model DialerSettings {
  id          String   @id
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId   String   @default("")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  data        Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

/// My To-Do: Day / Week / Month / Year (Oct 2026). Plan ahead or log what was already done, on any
/// date, past or future (a "done list"). The owner edits; their Team Lead and Super Admins can
/// read entries not marked private.
enum WorkLogPeriod {
  DAY
  WEEK
  MONTH
  YEAR
}

enum WorkLogStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

model WorkLogEntry {
  id          String        @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId   String        @default("")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation("WorkLogOwner", fields: [userId], references: [id], onDelete: Cascade)
  period      WorkLogPeriod
  /// First day of the period: the day itself, the Monday, the 1st of the month, or 1 January.
  periodStart DateTime      @db.Date
  title       String
  details     String?
  status      WorkLogStatus @default(PLANNED)
  doneAt      DateTime?
  /// Time spent, optional (e.g. 1.5).
  hours       Float?
  /// How many, optional (e.g. 25 listings uploaded).
  quantity    Int?
  tag         String?
  /// Only the owner sees it (hidden from their Team Lead).
  private     Boolean       @default(false)
  /// Stuck, needs help from the Team Lead. Shown at the top of the team view.
  blocked     Boolean       @default(false)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  notes       WorkLogNote[]

  @@index([userId, periodStart])
  @@index([userId, period, periodStart])
  @@index([companyId])
}

/// A note on a My To-Do item, e.g. the WhatsApp message from a manager that asked for it.
/// `source` is where it came from (WhatsApp, Email, Call, or any name the person types);
/// `sender` is who it came from (optional).
model WorkLogNote {
  id        String       @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String       @default("")
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entryId   String
  entry     WorkLogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("WorkLogNoteAuthor", fields: [userId], references: [id], onDelete: Cascade)
  source    String?
  sender    String?
  body      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([entryId])
  @@index([userId, source])
  @@index([companyId])
}

enum WorkLogRating {
  GOOD
  NEEDS_WORK
}

/// A Team Lead's review of one person's day, week, month or year in My To-Do: seen, with an
/// optional rating and comment (like work report confirmation in other ERPs).
model WorkLogReview {
  id          String         @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId   String         @default("")
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation("WorkLogReviewOwner", fields: [userId], references: [id], onDelete: Cascade)
  period      WorkLogPeriod
  periodStart DateTime       @db.Date
  reviewerId  String
  reviewer    User           @relation("WorkLogReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  rating      WorkLogRating?
  comment     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, period, periodStart])
  @@index([reviewerId])
  @@index([companyId])
}

/// A private key that lets Claude (a connector) work in Metriq as this person: read the tickets
/// they can see, comment on them and move them. Only a hash is stored; the key is shown once.
model ClaudeKey {
  id         String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId  String    @default("")
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Which app the key was made for: "claude", "chatgpt" or "gemini" (all use the same connector).
  client     String    @default("claude")
  tokenHash  String    @unique
  /// First characters of the key, to tell keys apart in the list.
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// System Health: the error log, the hourly self check, job heartbeats and outages.
// Only Super Admins and developers (User.isDeveloper) can see any of it.
// ---------------------------------------------------------------------------

enum ErrorSource {
  SERVER // a crash or 500 inside the API
  BROWSER // a page that broke in someone's browser
  JOB // a background job (reminders, auto checkout, deadlines) that failed
  SLOW // a request that took too long
}

enum ErrorState {
  OPEN
  RESOLVED
  IGNORED
}

/// One kind of error. The same error happening 200 times is one group with count 200.
model ErrorGroup {
  id           String       @id @default(cuid())
  fingerprint  String       @unique
  source       ErrorSource
  message      String
  stack        String?
  route        String? // "GET /api/projects/:key", a page path, or "job:auto-checkout"
  status       Int?
  count        Int          @default(1)
  userIds      String[] // distinct people it hit (first 50)
  state        ErrorState   @default(OPEN)
  firstSeenAt  DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  reopenedAt   DateTime? // set when a resolved error came back
  events       ErrorEvent[]

  @@index([state, lastSeenAt(sort: Desc)])
  @@index([source, lastSeenAt(sort: Desc)])
}

/// One time an error happened (kept 30 days, a sample during error storms).
model ErrorEvent {
  id         String     @id @default(cuid())
  groupId    String
  group      ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  at         DateTime   @default(now())
  userId     String?
  url        String?
  status     Int?
  durationMs Int?
  meta       Json?

  @@index([groupId, at(sort: Desc)])
  @@index([at])
}

enum AuditState {
  RUNNING
  PASSED
  WARN
  FAILED
}

enum CheckResult {
  PASS
  WARN
  FAIL
  SKIP
}

/// One run of the hourly self check.
model AuditRun {
  id          String       @id @default(cuid())
  trigger     String // schedule | manual | claude
  startedById String?
  state       AuditState   @default(RUNNING)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  total       Int          @default(0)
  passed      Int          @default(0)
  warned      Int          @default(0)
  failed      Int          @default(0)
  skipped     Int          @default(0)
  newProblems Int          @default(0)
  fixed       Int          @default(0)
  checks      AuditCheck[]

  @@index([startedAt(sort: Desc)])
}

/// One thing the self check looked at (an API, the database, disk space, a job...).
model AuditCheck {
  id       String      @id @default(cuid())
  runId    String
  run      AuditRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  category String // api-read | api-write | database | server | services | jobs | data | website
  name     String
  result   CheckResult
  ms       Int?
  status   Int?
  detail   String?
  isNew    Boolean     @default(false) // a problem now that was fine (or not there) last run
  fixed    Boolean     @default(false) // fine now, was failing last run

  @@index([runId])
  @@index([category, name])
}

/// Each background job reports here every time it runs.
model JobHeartbeat {
  name           String    @id
  lastRunAt      DateTime
  lastOkAt       DateTime?
  lastError      String?
  lastDurationMs Int?
  runs           Int       @default(0)
  failures       Int       @default(0)
}

/// A time the whole site was down, reported by the outside checker once it is back.
model UptimeEvent {
  id        String   @id @default(cuid())
  downAt    DateTime
  upAt      DateTime
  minutes   Int
  detail    String?
  createdAt DateTime @default(now())

  @@index([downAt(sort: Desc)])
}

// ================================================================== Owner console (erp, step 0)
// Metriq as a product: the companies that use it, the owner who runs it (Anees), and the
// complaints companies send from their Help button. 99 Technologies is company 1.
// The owner is NOT a user of any company: own table, own sign in, own cookie.

/// TEAM = a company with people; PERSONAL = one person using Metriq on their own (solo).
enum CompanyKind {
  TEAM
  PERSONAL
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Company {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  kind               CompanyKind   @default(TEAM)
  timeZone           String        @default("Asia/Karachi")
  status             CompanyStatus @default(ACTIVE)
  /// lib/plans: personal, starter, business, or internal (99 Technologies: no limits, never billed).
  plan               String        @default("starter")
  /// Parts of Metriq (lib/permissions AREAS) the owner switched off, or on beyond the plan, for this company.
  modulesOff         String[]      @default([])
  modulesOn          String[]      @default([])
  /// The company's Super Admin lets Metriq support sign in to help until then (help sign-in, step 6).
  supportAccessUntil DateTime?
  supportAccessById  String?
  /// Free trial (Phase 1, step 7): 14 days from sign-up; billing (step 8) ends it.
  trialEndsAt        DateTime?
  /// The setup wizard was finished (or skipped).
  setupDoneAt        DateTime?
  /// Rows the "sample data" button made, so they can be taken out again: { table: [ids] }.
  sampleIds          Json?
  /// Billing reminders already sent (trial ending, trial ended), so each goes once.
  trialEndingMailAt  DateTime?
  trialEndedMailAt   DateTime?
  /// The Help button for this company's people. Off for 99 Technologies until the owner turns it on.
  helpEnabled        Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tickets       SupportTicket[]
  users         User[]
  flagOverrides FeatureFlagCompany[]
  usage         CompanyUsage[]

  // Everything a company owns (Phase 1, step 2). Deleting a company deletes all of it;
  // company 1 (99 Technologies) can never be deleted (database trigger).
  departmentRows           Department[]
  subDepartmentRows        SubDepartment[]
  userDepartmentRows       UserDepartment[]
  entryAttachmentRows      EntryAttachment[]
  itadDailyEntryRows       ItadDailyEntry[]
  leadGenDailyEntryRows    LeadGenDailyEntry[]
  leadGenVerticalCountRows LeadGenVerticalCount[]
  talkloopDailyEntryRows   TalkloopDailyEntry[]
  talkloopCountryCountRows TalkloopCountryCount[]
  teamMemberEventRows      TeamMemberEvent[]
  tagRows                  Tag[]
  targetRows               Target[]
  salaryRecordRows         SalaryRecord[]
  holidayRows              Holiday[]
  leaveDayRows             LeaveDay[]
  attendanceDayRows        AttendanceDay[]
  officeNetworkRows        OfficeNetwork[]
  blockedCheckInRows       BlockedCheckIn[]
  attendanceReminderRows   AttendanceReminder[]
  attendanceViolationRows  AttendanceViolation[]
  breakEntryRows           BreakEntry[]
  attendanceShiftRows      AttendanceShift[]
  rdpRows                  Rdp[]
