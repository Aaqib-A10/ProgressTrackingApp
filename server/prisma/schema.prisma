}

// ---------- Audit trail (§9) ----------

/// Edit history so submitted numbers cannot be quietly changed.
model AuditLog {
  id         String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId  String   @default("")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  entityType String // "ItadDailyEntry", "Target", ...
  entityId   String
  action     String // "CREATE" | "UPDATE" | "DELETE"
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  // The Activity Log viewer filters by createdAt (range) + optional userId and
  // orders by createdAt desc; AuditLog is append-only and the largest table.
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([companyId])
}

/// A sign-in event — who logged in, when, from where (IP) and on which device.
model LoginEvent {
  id        String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String   @default("")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Nullable + SetNull so deleting a user preserves the sign-in audit trail
  // (matches AuditLog). In practice users are soft-deleted (isActive=false).
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String   @default("LOGIN") // "LOGIN" | "SIGNUP"
  ip        String?
  userAgent String?
  browser   String? // e.g. "Chrome"
  os        String? // e.g. "Windows"
  device    String? // "Desktop" | "Mobile" | "Tablet"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([companyId])
}

