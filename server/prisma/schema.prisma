// ---------- Marketing tasks: Kanban board + editorial calendar + content (§6.3/§6.4) ----------
model MarketingTask {
  id          String              @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId   String              @default("")
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  discipline  MarketingDiscipline
  status      TaskStatus          @default(BACKLOG)
  priority    Priority            @default(MEDIUM)
  order       Int                 @default(0) // position within its column

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id])

  // Optional brand/profile a content card targets (drives board brand filter + blog origin)
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  // Content-specific (when discipline = CONTENT)
  contentType ContentType?
  wordCount   Int?
  wordTarget  Int?

  // Social-specific (when discipline = SOCIAL) — drives the Social Planner column
  platform SocialPlatform?

  // Editorial calendar — planned vs actual
  dueDate       DateTime? @db.Date
  scheduledDate DateTime? @db.Date
  publishedDate DateTime? @db.Date
  completedAt   DateTime? // set when the task reaches PUBLISHED; powers "completed by day/week"

  // Full due timestamp (date + time). Drives the "1h before due" reminder for urgent tasks.
  dueAt             DateTime?
  dueReminderSentAt DateTime? // claim stamp so the reminder fires at most once

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    MarketingTaskComment[]
  attachments EntryAttachment[]

  @@index([status])
  @@index([discipline])
  @@index([scheduledDate])
  @@index([discipline, scheduledDate])
  @@index([assigneeId])
  @@index([priority, dueAt])
  @@index([companyId])
}

/// Once-only claim so the scheduled monthly report emails each (month, department)
/// exactly once, even across restarts or multiple cron ticks on the 1st–2nd.
model SentMonthlyReport {
  id         String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId  String   @default("")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month      String // 'YYYY-MM'
  department String
  sentAt     DateTime @default(now())

  @@unique([companyId, month, department])
  @@index([companyId])
}

enum NotificationType {
  MENTION
  GRACE_EXCEEDED
  BREAK_OVERRUN
  BRB_OVERRUN
  GRACE_LIMIT
  TASK_ASSIGNED
  TASK_DUE_SOON
  // Projects module
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  TASK_COMMENT
  TASK_DUE_CHANGED
  TASK_OVERDUE
  EXTENSION_REQUESTED
  EXTENSION_DECIDED
  PROJECT_MEMBER_ADDED
  CHAT_MESSAGE
  TASK_REVIEW
  MEETING
  AUTO_CHECKOUT
  WFH_REQUESTED
  WFH_DECIDED
  WORKLOG_REVIEW
  NETWORK_BLOCKED
  SYSTEM_HEALTH
  BREAK_CUTOFF
  ATTENDANCE_EDITED
  SUPPORT_REPLY
}

enum BreakType {
  BREAK // regular break / lunch (configurable allowance, default 65m)
  BRB // Be Right Back — short breaks (configurable allowance, default 20m)
}

enum ViolationKind {
  LATE_SIGNIN // exceeded sign-in grace on a working day
  BREAK_OVERRUN // regular break over its allowance
  BRB_OVERRUN // BRB total over its allowance
  LATE_LIMIT // >3 late sign-ins in a calendar month (date = first-of-month)
}

/// A delivered, per-recipient notification (e.g. an @mention on a board card).
/// Read state is per row; the bell shows unread ones and marks them read on click.
model Notification {
  id         String           @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId  String           @default("")
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String // recipient
  user       User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType @default(MENTION)
  actorId    String? // who triggered it
  actor      User?            @relation("NotificationActor", fields: [actorId], references: [id])
  title      String
  body       String
  link       String? // client route to open when clicked
  entityType String? // e.g. "MarketingTask"
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([companyId])
}

model MarketingTaskComment {
  id        String        @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String        @default("")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId    String
  task      MarketingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation("MarketingCommentAuthor", fields: [authorId], references: [id])
  body      String
  mentions  String[] // user ids @mentioned in the body
  createdAt DateTime      @default(now())

  @@index([taskId])
  @@index([companyId])
}

// ---------- Marketing brands / profiles + monthly reporting (§6) ----------

/// A company profile / brand the Marketing team manages (e.g. Minnesota
/// Computers, Recycle Technologies). The spine that ties monthly social stats,
/// blog counts and master-plan items together. User-manageable (add/edit).
model Brand {
  id               String       @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId        String       @default("")
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId     String // always the MARKETING department
  department       Department   @relation(fields: [departmentId], references: [id])
  name             String
  slug             String
  website          String?
  isActive         Boolean      @default(true) // soft-delete; preserves historical stats
  // Service tier — how much active management this brand suite gets.
  tier             ServiceTier  @default(TIER_1)
  // Brand owner (the lead accountable for this suite). Nullable; SetNull on user delete.
  ownerId          String?
  owner            User?        @relation("BrandOwner", fields: [ownerId], references: [id])
  // CRM connection tracker (registry only — no live sync). "Connected" once crmStatus = CONNECTED.
  crmProvider      CrmProvider?
  crmStatus        CrmStatus    @default(NONE)
  crmAccount       String? // account name / workspace / URL
  crmNote          String?
  crmCheckedAt     DateTime? // last time the CRM connection was verified/reviewed
  // SEO search-term landing pages (e.g. RTI's 80-100 keyword pages on one site):
  // the goal count. Live pages are tracked as SearchTermPage rows; ratio = live/target.
  searchTermTarget Int?
  // SEO integration — a brand is "connected" once both are set.
  gscSiteUrl       String? // Search Console property, e.g. "sc-domain:example.com" or "https://example.com/"
  ga4PropertyId    String? // GA4 property, e.g. "properties/123456789" (or the bare numeric id)
  seoSyncedAt      DateTime? // last successful GSC/GA sync
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  socialStats BrandSocialMonthly[]
  seoDaily    BrandSeoDaily[]
  blogs       BlogPost[]
  tasks       MarketingTask[]
  planItems   MarketingPlanItem[]
  adCampaigns AdCampaign[]
  targets     Target[]
  profiles    BrandProfile[]
  searchTerms SearchTermPage[]

  @@unique([departmentId, slug])
  @@index([departmentId, isActive])
  @@index([companyId])
}

/// A single SEO search-term landing page for a brand (one keyword/term → one URL).
/// A brand's `searchTermTarget` is the goal; the count of status=LIVE rows is the
/// numerator of the live/target ratio.
model SearchTermPage {
  id        String           @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String           @default("")
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  term      String // the search term / keyword this page targets
  url       String? // the published page URL (null until built)
  status    SearchTermStatus @default(PLANNED)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([brandId])
  @@index([companyId])
}

/// Build state of a search-term page. LIVE counts toward the live/target ratio.
enum SearchTermStatus {
  PLANNED
  IN_PROGRESS
  LIVE
}

/// Service tier for a brand suite — drives how effort is allocated across the portfolio.
enum ServiceTier {
  TIER_1
  TIER_2
  MAINTENANCE
}

/// CRM the brand is (or is being) connected to — registry/tracker only.
enum CrmProvider {
  HUBSPOT
  SALESFORCE
  ZOHO
  PIPEDRIVE
  MONDAY
  OTHER
}

/// Tracked state of a brand's CRM connection (no live integration).
enum CrmStatus {
  NONE
  PLANNED
  IN_PROGRESS
  CONNECTED
}

/// A single platform account we manage for a brand (its Facebook page, LinkedIn
/// company profile, X handle, website, …). A brand may hold more than one per
/// platform (e.g. regional pages), so no per-platform uniqueness is enforced.
model BrandProfile {
  id              String          @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId       String          @default("")
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandId         String
  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform        ProfilePlatform
  handle          String? // @handle or page name
  url             String? // profile URL
  status          ProfileStatus   @default(ACTIVE)
  // How this channel is published: centralised via the Mixpost workspace, or
  // posted manually one login at a time (e.g. Reddit, which Mixpost can't post to).
  managedVia      ManagedVia      @default(MANUAL)
  // Meta Business Suite / Business Manager this page is connected under (FB/IG).
  businessSuiteId String?
  businessSuite   BusinessSuite?  @relation(fields: [businessSuiteId], references: [id])
  ownerId         String?
  owner           User?           @relation("BrandProfileOwner", fields: [ownerId], references: [id])
  note            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([brandId])
  @@index([businessSuiteId])
  @@index([companyId])
}

/// A Meta Business Suite / Business Manager account. Dept-scoped and shared across
/// brands (one Business Manager can hold pages for several brands, e.g. the group's
/// "99 Technologies" BM). FB/IG profiles connect to one via businessSuiteId.
model BusinessSuite {
  id                String     @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId         String     @default("")
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id])
  name              String
  businessManagerId String? // Meta Business Manager ID
  url               String? // link to the Business Suite / Manager
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  profiles BrandProfile[]

  @@unique([departmentId, name])
  @@index([companyId])
}

