  OTHER
}

/// Source of a monthly stat row — manual entry now, platform-API sync later.
enum StatSource {
  MANUAL
  API
}

/// One monthly snapshot per brand + platform. `followers` is a total snapshot;
/// month-over-month growth is derived. Upsert key = (brandId, platform, month).
model BrandSocialMonthly {
  id        String         @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String         @default("")
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform  SocialPlatform
  month     String // "YYYY-MM"

  followers   Int @default(0) // total followers at month end
  impressions Int @default(0)
  engagement  Int @default(0)
  reach       Int @default(0)
  posts       Int @default(0)

  // Extended metrics from LinkedIn Analytics / Meta Business Suite exports.
  newFollowers   Int   @default(0) // followers gained in the month
  visitors       Int   @default(0) // unique page visitors
  engagementRate Float @default(0) // avg engagement rate as a percentage, e.g. 21.4
  clicks         Int   @default(0)
  reactions      Int   @default(0) // likes + reactions
  views          Int   @default(0) // post/video views

  source      StatSource @default(MANUAL)
  enteredById String?
  enteredBy   User?      @relation("BrandSocialEnteredBy", fields: [enteredById], references: [id])
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([brandId, platform, month])
  @@index([brandId, month])
  @@index([month])
  @@index([companyId])
}

/// One day of SEO metrics per brand, pulled from Google Search Console (GSC) and
/// Google Analytics (GA4). Stored daily so day/week/month rollups derive on read.
/// Upsert key = (brandId, date). CTR and position are averages, not sums —
/// aggregate them impressions-weighted, never added.
model BrandSeoDaily {
  id        String   @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String   @default("")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date

  // Google Search Console
  clicks      Int   @default(0)
  impressions Int   @default(0)
  ctr         Float @default(0) // click-through rate, 0..1 (as GSC returns it)
  position    Float @default(0) // average position (lower is better)

  // Google Analytics (GA4)
  sessions        Int   @default(0)
  users           Int   @default(0) // activeUsers
  newUsers        Int   @default(0)
  engagedSessions Int   @default(0)
  conversions     Int   @default(0)
  bounceRate      Float @default(0) // 0..1

  source    StatSource @default(API)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([brandId, date])
  @@index([brandId, date])
  @@index([companyId])
}

/// A blog/article attributed to a brand, for month-end per-brand counts.
model BlogPost {
  id          String     @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId   String     @default("")
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand      @relation(fields: [brandId], references: [id])
  title       String
  url         String?
  wordCount   Int?
  status      BlogStatus @default(DRAFT) // publish state (drives the "published or not" column)
  authorId    String?
  author      User?      @relation("BlogAuthor", fields: [authorId], references: [id])
  publishedAt DateTime?  @db.Date
  month       String // "YYYY-MM" the blog counts toward (denormalized for fast counts)
  taskId      String? // optional link to the originating MarketingTask card
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([brandId, month])
  @@index([month])
  @@index([companyId])
}

/// A single ad campaign record under the ADS Campaign sub-department. Per brand +
/// platform + month; totals and "best performing/conversion" are computed on read
/// from these rows (see /marketing/ads/summary).
model AdCampaign {
  id           String           @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId    String           @default("")
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandId      String
  brand        Brand            @relation(fields: [brandId], references: [id])
  platform     AdPlatform
  month        String // "YYYY-MM" rollup bucket (derived from date)
  date         DateTime?        @db.Date // the campaign's day; nullable for legacy rows (backfilled to month-01)
  title        String
  campaignType AdCampaignType   @default(OTHER)
  status       AdCampaignStatus @default(ACTIVE)

  leads         Int     @default(0)
  businessLeads Int     @default(0)
  conversions   Int     @default(0) // legacy; replaced in the UI by computed Avg. Cost Per Lead (spend/leads)
  spend         Decimal @default(0) @db.Decimal(12, 2) // currency units, 2dp
  impressions   Int     @default(0)
  clicks        Int     @default(0)

  createdById String?
  createdBy   User?    @relation("AdCampaignCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brandId, platform, month])
  @@index([month])
  @@index([brandId, date])
  @@index([companyId])
}

/// The content lead's monthly Master Plan — a month-scoped container of items.
model MarketingPlan {
  id              String         @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
