  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task      PmTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId   String
  label     PmLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([companyId])
}

model PmChecklistItem {
  id        String    @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId String    @default("")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId    String
  task      PmTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  isDone    Boolean   @default(false)
  position  Int       @default(0)
  doneById  String?
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([taskId])
  @@index([companyId])
}

/// A review on a task: who reviewed it, their verdict and feedback.
enum PmReviewVerdict {
  APPROVED
  CHANGES_REQUESTED
  COMMENT
}

model PmReview {
  id         String          @id @default(cuid())
  /// The company this belongs to (Phase 1, step 2). Filled in by lib/tenancy.
  companyId  String          @default("")
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId     String
