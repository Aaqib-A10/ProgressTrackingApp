{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:test-users": "tsx prisma/test-users.ts",
    "import:rdp": "tsx prisma/importRdp.ts",
    "metra:demo": "tsx src/scripts/metraDemo.ts",
    "metra:eval": "tsx src/scripts/metraEval.ts",
    "metra:check": "tsx src/scripts/metraCheck.ts",
    "metra:bench": "tsx src/scripts/metraBench.ts",
    "metra:models": "tsx -e \"require('./src/lib/metra/embed').embedQuery('warm up').then(()=>require('./src/lib/metra/embed').rerank('a',['b'])).then(()=>console.log('Metra models ready'))\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@prisma/client": "^6.1.0",
    "@types/papaparse": "^5.5.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "imapflow": "^1.7.8",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mailparser": "^3.14.1",
    "node-cron": "^4.6.0",
    "papaparse": "^5.5.4",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.7.1",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
